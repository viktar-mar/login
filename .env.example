# Public browser configuration only. Never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy-the-public-key-from-supabase-status

# Canonical application origin: no path or trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ordered comma-separated subset: google,facebook,apple,github,azure,discord
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook,apple,github,azure,discord
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=true
